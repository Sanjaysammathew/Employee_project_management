APP_NAME=Employee Management API
APP_VERSION=1.0.0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
MAIL_FROM=your_email@gmail.com

DATABASE_NAME=employee_project_db
DATABASE_USER=replace_with_local_database_user
DATABASE_PASSWORD=replace_with_local_database_password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_DRIVER=postgresql+asyncpg
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_password@127.0.0.1:5432/employee_project_test_db

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
